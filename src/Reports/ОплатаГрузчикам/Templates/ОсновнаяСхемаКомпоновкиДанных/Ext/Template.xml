	Товары.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	Грузчики.Ссылка КАК Заявка,
	Грузчики.Грузчик КАК Грузчик
ПОМЕСТИТЬ ВТГрузчики
ИЗ
	Документ.ЗаявкаНаТранспорт.Грузчики КАК Грузчики
ГДЕ
	Грузчики.Грузчик &lt;&gt; ЗНАЧЕНИЕ(Справочник.Грузчики.ПустаяСсылка)
	И НЕ Грузчики.Ссылка.ПометкаУдаления
	И Грузчики.Ссылка.ДатаДоставки МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТГрузчики.Заявка КАК Заявка,
	КОЛИЧЕСТВО(ВТГрузчики.Грузчик) КАК ЧислоГрузчиков
ПОМЕСТИТЬ ВТЧислоГрузчиков
ИЗ
	ВТГрузчики КАК ВТГрузчики

СГРУППИРОВАТЬ ПО
	ВТГрузчики.Заявка
;

