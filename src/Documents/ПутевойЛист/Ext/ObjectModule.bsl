// Путевой лист фиксирует фактическое выполнение рейса по заявке:
// показания спидометра и пробег. При проведении пишет оборот
// в регистр накопления «Работа транспорта».

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	// Ввод на основании заявки: переносим машину и водителя.
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаНаТранспорт") Тогда
		Заявка   = ДанныеЗаполнения;
		Машина   = ДанныеЗаполнения.Машина;
		Водитель = ДанныеЗаполнения.Водитель;
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если СпидометрВозврат < СпидометрВыезд Тогда
		Сообщить("Показание спидометра при возврате не может быть меньше, чем при выезде");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	// Пробег считается автоматически, вручную не вводится.
	Километраж = СпидометрВозврат - СпидометрВыезд;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.РаботаТранспорта.Записывать = Истина;

	Движение = Движения.РаботаТранспорта.Добавить();
	Движение.Период           = Дата;
	Движение.Машина           = Машина;
	Движение.Водитель         = Водитель;
	Движение.Километраж       = Километраж;
	Движение.КоличествоРейсов = 1;

КонецПроцедуры
