Перем СуммаДокумента;

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.СтатусыЗаявки.НеВыехали;
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если Не ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.СтатусыЗаявки.НеВыехали;
	КонецЕсли;

	СуммаДокумента = 0;
	Для Каждого Строка Из Товары Цикл
		Строка.Сумма = Строка.Количество * Строка.Цена;
		СуммаДокумента = СуммаДокумента + Строка.Сумма;
	КонецЦикла;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если СуммаДокумента > 1000 Тогда
		Сообщить("Возможна бесплатная доставка");
	КонецЕсли;

КонецПроцедуры

// При проведении начисляем оплату грузчикам: 10 руб. за единицу товара,
// поровну между всеми грузчиками заявки. Начисление записывается приходом
// в регистр «Взаиморасчеты с грузчиками» (это долг перед грузчиком).
Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.ВзаиморасчетыСГрузчиками.Записывать = Истина;

	// Убираем пустые строки и повторы одного грузчика.
	СписокГрузчиков = Грузчики.Выгрузить(, "Грузчик");
	СписокГрузчиков.Свернуть("Грузчик");
	ПустаяСтрока = СписокГрузчиков.Найти(Справочники.Грузчики.ПустаяСсылка(), "Грузчик");
	Если ПустаяСтрока <> Неопределено Тогда
		СписокГрузчиков.Удалить(ПустаяСтрока);
	КонецЕсли;

	ЧислоГрузчиков = СписокГрузчиков.Количество();
	Если ЧислоГрузчиков = 0 Тогда
		Возврат;
	КонецЕсли;

	СуммаНаГрузчика = Окр(Товары.Итог("Количество") * 10 / ЧислоГрузчиков, 2);

	Для Каждого Строка Из СписокГрузчиков Цикл
		Движение = Движения.ВзаиморасчетыСГрузчиками.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период      = Дата;
		Движение.Грузчик     = Строка.Грузчик;
		Движение.Сумма       = СуммаНаГрузчика;
	КонецЦикла;

КонецПроцедуры
