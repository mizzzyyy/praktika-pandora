// Заполнение базы демонстрационными данными.
// Вызывается общей командой «Заполнить демо-данными» (раздел «Транспорт», меню «Сервис»).
//
// Что делает (повторный запуск ничего не дублирует, кроме выплаты):
//   1. Если справочники пустые — создаёт машины, водителей, грузчиков,
//      контрагентов с контактными лицами и номенклатуру.
//   2. Если заявок нет — создаёт заявки на текущий месяц.
//   3. Проводит все заявки (начисление оплаты грузчикам).
//   4. По каждой заявке без путевого листа создаёт и проводит путевой лист.
//   5. Создаёт выплату грузчикам на 70% текущего долга.

#Область ПрограммныйИнтерфейс

Функция Заполнить() Экспорт

	Отчет = Новый Массив;
	ГСЧ = Новый ГенераторСлучайныхЧисел(2026);

	ЗаполнитьСправочники(Отчет);
	СоздатьЗаявки(Отчет, ГСЧ);
	ПровестиЗаявки(Отчет);
	СоздатьПутевыеЛисты(Отчет, ГСЧ);
	СоздатьВыплату(Отчет);

	Возврат СтрСоединить(Отчет, Символы.ПС);

КонецФункции

#КонецОбласти

#Область Справочники

Процедура ЗаполнитьСправочники(Отчет)

	Если СправочникПуст("ТранспортныеСредства") Тогда
		Машины = Новый Массив;
		Машины.Добавить(Новый Структура("Имя, Номер", "ГАЗель Next", "А123ВС77"));
		Машины.Добавить(Новый Структура("Имя, Номер", "ГАЗель Бизнес", "В456ОР77"));
		Машины.Добавить(Новый Структура("Имя, Номер", "Isuzu Elf", "Е789КМ99"));
		Машины.Добавить(Новый Структура("Имя, Номер", "Hyundai HD-78", "К321НТ197"));
		Для Каждого Данные Из Машины Цикл
			Элемент = Справочники.ТранспортныеСредства.СоздатьЭлемент();
			Элемент.Наименование = Данные.Имя + " " + Данные.Номер;
			Элемент.ГосНомер = Данные.Номер;
			Элемент.Записать();
		КонецЦикла;
		Отчет.Добавить("Создано машин: " + Машины.Количество());
	КонецЕсли;

	Если СправочникПуст("Водители") Тогда
		Имена = СтрРазделить("Смирнов Алексей Петрович,Кузнецов Игорь Сергеевич,Попов Дмитрий Андреевич", ",");
		Для Каждого Имя Из Имена Цикл
			Элемент = Справочники.Водители.СоздатьЭлемент();
			Элемент.Наименование = Имя;
			Элемент.ФизическоеЛицо = ФизическоеЛицо(Имя);
			Элемент.Записать();
		КонецЦикла;
		Отчет.Добавить("Создано водителей: " + Имена.Количество());
	КонецЕсли;

	Если СправочникПуст("Грузчики") Тогда
		Имена = СтрРазделить("Васильев Олег Иванович,Петров Сергей Николаевич,Соколов Артём Викторович,Морозов Илья Олегович", ",");
		Для Каждого Имя Из Имена Цикл
			Элемент = Справочники.Грузчики.СоздатьЭлемент();
			Элемент.Наименование = Имя;
			Элемент.ФизическоеЛицо = ФизическоеЛицо(Имя);
			Элемент.Записать();
		КонецЦикла;
		Отчет.Добавить("Создано грузчиков: " + Имена.Количество());
	КонецЕсли;

	Если СправочникПуст("Контрагенты") Тогда
		Клиенты = Новый Массив;
		Клиенты.Добавить(Новый Структура("Имя, Контакт, Телефон", "ООО ""Мебельный двор""", "Орлова Анна Викторовна", "+7 (495) 111-22-33"));
		Клиенты.Добавить(Новый Структура("Имя, Контакт, Телефон", "ИП Лебедев С.А.", "Лебедев Сергей Александрович", "+7 (916) 222-33-44"));
		Клиенты.Добавить(Новый Структура("Имя, Контакт, Телефон", "ООО ""СтройМаркет""", "Зайцева Ольга Игоревна", "+7 (495) 333-44-55"));
		Для Каждого Данные Из Клиенты Цикл
			Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
			Контрагент.Наименование = Данные.Имя;
			Контрагент.Записать();
			Контакт = Справочники.КонтактныеЛица.СоздатьЭлемент();
			Контакт.Владелец = Контрагент.Ссылка;
			Контакт.Наименование = Данные.Контакт;
			Контакт.ФизическоеЛицо = ФизическоеЛицо(Данные.Контакт);
			Контакт.Телефон = Данные.Телефон;
			Контакт.Записать();
		КонецЦикла;
		Отчет.Добавить("Создано контрагентов: " + Клиенты.Количество());
	КонецЕсли;

	Если СправочникПуст("Номенклатура") Тогда
		Товары = СтрРазделить("Диван угловой,Шкаф-купе,Стол обеденный,Стул,Холодильник,Стиральная машина,Мешок цемента 50 кг,Коробка с плиткой", ",");
		Для Каждого Имя Из Товары Цикл
			Элемент = Справочники.Номенклатура.СоздатьЭлемент();
			Элемент.Наименование = Имя;
			Элемент.Записать();
		КонецЦикла;
		Отчет.Добавить("Создано позиций номенклатуры: " + Товары.Количество());
	КонецЕсли;

КонецПроцедуры

Функция СправочникПуст(Имя)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка ИЗ Справочник." + Имя + " КАК Т");
	Возврат Запрос.Выполнить().Пустой();

КонецФункции

Функция ФизическоеЛицо(Имя)

	Ссылка = Справочники.ФизическиеЛица.НайтиПоНаименованию(Имя, Истина);
	Если Не Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;
	Элемент = Справочники.ФизическиеЛица.СоздатьЭлемент();
	Элемент.Наименование = Имя;
	Элемент.Записать();
	Возврат Элемент.Ссылка;

КонецФункции

Функция ВсеЭлементы(Имя)

	Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка ИЗ Справочник." + Имя + " КАК Т ГДЕ НЕ Т.ПометкаУдаления УПОРЯДОЧИТЬ ПО Т.Наименование");
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

#КонецОбласти

#Область Документы

Процедура СоздатьЗаявки(Отчет, ГСЧ)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка ИЗ Документ.ЗаявкаНаТранспорт КАК Д");
	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;

	Машины      = ВсеЭлементы("ТранспортныеСредства");
	Водители    = ВсеЭлементы("Водители");
	Грузчики    = ВсеЭлементы("Грузчики");
	Контрагенты = ВсеЭлементы("Контрагенты");
	Товары      = ВсеЭлементы("Номенклатура");

	НачалоМесяца = НачалоМесяца(ТекущаяДатаСеанса());
	ЧислоЗаявок = 8;

	Для Номер = 1 По ЧислоЗаявок Цикл

		Заявка = Документы.ЗаявкаНаТранспорт.СоздатьДокумент();
		ДатаДоставки = НачалоМесяца + (Номер * 3 - 2) * 86400 + (9 + ГСЧ.СлучайноеЧисло(0, 8)) * 3600;
		Заявка.Дата = НачалоДня(ДатаДоставки) + 8 * 3600; // заявка оформляется утром в день доставки
		Заявка.ДатаДоставки = ДатаДоставки;
		Заявка.Контрагент = Контрагенты[(Номер - 1) % Контрагенты.Количество()];
		Контакты = Справочники.КонтактныеЛица.Выбрать(, Заявка.Контрагент);
		Если Контакты.Следующий() Тогда
			Заявка.КонтактноеЛицо = Контакты.Ссылка;
		КонецЕсли;
		Заявка.Машина = Машины[(Номер - 1) % Машины.Количество()];
		Заявка.Водитель = Водители[(Номер - 1) % Водители.Количество()];
		Заявка.Статус = Перечисления.СтатусыЗаявки.Обработан;

		Для Индекс = 1 По ГСЧ.СлучайноеЧисло(1, 3) Цикл
			Строка = Заявка.Товары.Добавить();
			Строка.Номенклатура = Товары[ГСЧ.СлучайноеЧисло(0, Товары.Количество() - 1)];
			Строка.Количество = ГСЧ.СлучайноеЧисло(1, 10);
			Строка.Цена = ГСЧ.СлучайноеЧисло(5, 60) * 100;
		КонецЦикла;

		ЧислоГрузчиков = Мин(ГСЧ.СлучайноеЧисло(1, 3), Грузчики.Количество());
		Первый = ГСЧ.СлучайноеЧисло(0, Грузчики.Количество() - 1);
		Для Индекс = 0 По ЧислоГрузчиков - 1 Цикл
			Заявка.Грузчики.Добавить().Грузчик = Грузчики[(Первый + Индекс) % Грузчики.Количество()];
		КонецЦикла;

		Заявка.Записать(РежимЗаписиДокумента.Запись);

	КонецЦикла;

	Отчет.Добавить("Создано заявок: " + ЧислоЗаявок);

КонецПроцедуры

Процедура ПровестиЗаявки(Отчет)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Д.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаявкаНаТранспорт КАК Д
	|ГДЕ
	|	НЕ Д.ПометкаУдаления
	|	И НЕ Д.Проведен
	|УПОРЯДОЧИТЬ ПО
	|	Д.Дата");

	Проведено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			Выборка.Ссылка.ПолучитьОбъект().Записать(РежимЗаписиДокумента.Проведение);
			Проведено = Проведено + 1;
		Исключение
			Отчет.Добавить("Не удалось провести " + Выборка.Ссылка + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Если Проведено > 0 Тогда
		Отчет.Добавить("Проведено заявок: " + Проведено);
	КонецЕсли;

КонецПроцедуры

Процедура СоздатьПутевыеЛисты(Отчет, ГСЧ)

	// Заявки с машиной, по которым ещё нет путевого листа.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Заявка.Ссылка КАК Ссылка,
	|	Заявка.Дата КАК Дата,
	|	Заявка.ДатаДоставки КАК ДатаДоставки,
	|	Заявка.Машина КАК Машина
	|ИЗ
	|	Документ.ЗаявкаНаТранспорт КАК Заявка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПутевойЛист КАК ПутевойЛист
	|		ПО (ПутевойЛист.Заявка = Заявка.Ссылка)
	|			И (НЕ ПутевойЛист.ПометкаУдаления)
	|ГДЕ
	|	Заявка.Проведен
	|	И Заявка.Машина <> ЗНАЧЕНИЕ(Справочник.ТранспортныеСредства.ПустаяСсылка)
	|	И ПутевойЛист.Ссылка ЕСТЬ NULL
	|УПОРЯДОЧИТЬ ПО
	|	Заявка.ДатаДоставки");

	// Последнее показание спидометра по каждой машине (из уже введённых путевых листов).
	Спидометр = Новый Соответствие;
	ЗапросПоказаний = Новый Запрос(
	"ВЫБРАТЬ
	|	ПЛ.Машина КАК Машина,
	|	МАКСИМУМ(ПЛ.СпидометрВозврат) КАК Показание
	|ИЗ
	|	Документ.ПутевойЛист КАК ПЛ
	|СГРУППИРОВАТЬ ПО
	|	ПЛ.Машина");
	ВыборкаПоказаний = ЗапросПоказаний.Выполнить().Выбрать();
	Пока ВыборкаПоказаний.Следующий() Цикл
		Спидометр.Вставить(ВыборкаПоказаний.Машина, ВыборкаПоказаний.Показание);
	КонецЦикла;

	Создано = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Показание = Спидометр.Получить(Выборка.Машина);
		Если Показание = Неопределено Тогда
			Показание = ГСЧ.СлучайноеЧисло(20, 150) * 1000;
		КонецЕсли;

		ПутевойЛист = Документы.ПутевойЛист.СоздатьДокумент();
		ПутевойЛист.Заполнить(Выборка.Ссылка); // как «Создать на основании»
		ПутевойЛист.Дата = ?(ЗначениеЗаполнено(Выборка.ДатаДоставки), Выборка.ДатаДоставки, Выборка.Дата);
		ПутевойЛист.СпидометрВыезд = Показание;
		ПутевойЛист.СпидометрВозврат = Показание + ГСЧ.СлучайноеЧисло(15, 180);

		Попытка
			ПутевойЛист.Записать(РежимЗаписиДокумента.Проведение);
			Спидометр.Вставить(Выборка.Машина, ПутевойЛист.СпидометрВозврат);
			Создано = Создано + 1;
		Исключение
			Отчет.Добавить("Не удалось создать путевой лист по " + Выборка.Ссылка + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	Отчет.Добавить("Создано путевых листов: " + Создано);

КонецПроцедуры

Процедура СоздатьВыплату(Отчет)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Остатки.Грузчик КАК Грузчик,
	|	Остатки.СуммаОстаток КАК Долг
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСГрузчиками.Остатки КАК Остатки
	|ГДЕ
	|	Остатки.СуммаОстаток > 0
	|УПОРЯДОЧИТЬ ПО
	|	Остатки.Грузчик.Наименование");

	Выплата = Документы.ВыплатаГрузчикам.СоздатьДокумент();
	Выплата.Дата = ТекущаяДатаСеанса();

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сумма = Окр(Выборка.Долг * 0.7, 2);
		Если Сумма > 0 Тогда
			Строка = Выплата.Выплаты.Добавить();
			Строка.Грузчик = Выборка.Грузчик;
			Строка.Сумма = Сумма;
		КонецЕсли;
	КонецЦикла;

	Если Выплата.Выплаты.Количество() = 0 Тогда
		Отчет.Добавить("Выплата не создана: долгов перед грузчиками нет");
		Возврат;
	КонецЕсли;

	Попытка
		Выплата.Записать(РежимЗаписиДокумента.Проведение);
		Отчет.Добавить("Создана выплата грузчикам на сумму " + Формат(Выплата.Выплаты.Итог("Сумма"), "ЧДЦ=2") + " руб.");
	Исключение
		Отчет.Добавить("Не удалось провести выплату: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
