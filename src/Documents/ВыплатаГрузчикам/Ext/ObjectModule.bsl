// Выплата грузчикам уменьшает долг перед грузчиками:
// при проведении пишет расход в регистр «Взаиморасчеты с грузчиками».
// Выплатить больше, чем начислено, нельзя.

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// Блокируем остатки грузчиков из документа, чтобы два пользователя
	// не провели выплату одному и тому же грузчику одновременно.
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ВзаиморасчетыСГрузчиками");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = Выплаты;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Грузчик", "Грузчик");
	Блокировка.Заблокировать();

	Движения.ВзаиморасчетыСГрузчиками.Записывать = Истина;

	Для Каждого Строка Из Выплаты Цикл
		Движение = Движения.ВзаиморасчетыСГрузчиками.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период      = Дата;
		Движение.Грузчик     = Строка.Грузчик;
		Движение.Сумма       = Строка.Сумма;
	КонецЦикла;

	Движения.ВзаиморасчетыСГрузчиками.Записать();

	// Контроль: после записи движений долг не должен стать отрицательным.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Грузчик КАК Грузчик,
	|	Остатки.СуммаОстаток КАК Остаток
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСГрузчиками.Остатки(
	|			,
	|			Грузчик В (&Грузчики)) КАК Остатки
	|ГДЕ
	|	Остатки.СуммаОстаток < 0";
	Запрос.УстановитьПараметр("Грузчики", Выплаты.ВыгрузитьКолонку("Грузчик"));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сообщить("Грузчику " + Выборка.Грузчик + " выплачено больше начисленного на "
			+ Формат(-Выборка.Остаток, "ЧДЦ=2"));
		Отказ = Истина;
	КонецЦикла;

КонецПроцедуры
